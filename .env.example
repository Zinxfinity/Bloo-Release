# ============================================================
# Bloo environment settings
# Build: release-production (no economy, no dashboard)
#
# Copy this file to .env and fill it in before starting. Never commit .env.
# The bot (index.js) and the optional alert watchdog (watchdog.js) both read
# the same .env from this folder. Only FLUXER_BOT_TOKEN and BOT_OWNERS are
# needed to start; everything else is optional.
#
# Keep comments on their own line. A systemd EnvironmentFile reads
# everything after = as the value, comment and all.
# ============================================================

# ------------------------------------------------------------
# Core
# ------------------------------------------------------------
FLUXER_BOT_TOKEN=
# Comma-separated user IDs with full bot-owner access
BOT_OWNERS=
# Default command prefix for new servers
PREFIX=b!
# SQLite database, relative to this folder
DB_PATH=data/bot.db
# Your bot application's ID, from your Fluxer developer settings
FLUXER_CLIENT_ID=
# Bot avatar used on webhook posts
BLOO_PFP_URL=


# ------------------------------------------------------------
# Webhooks (all optional, each a Fluxer webhook URL:
# https://api.fluxer.app/webhooks/{id}/{token})
# ------------------------------------------------------------
# Error reports from the bot, labelled by area
ERROR_WEBHOOK_URL=
# Bot start, restart and shutdown notices
STARTUP_WEBHOOK_URL=
# Fluxer platform status alerts
FLUXER_STATUS_WEBHOOK_URL=
# Where b!changelog publish posts new releases
CHANGELOG_WEBHOOK_URL=

# ------------------------------------------------------------
# Features
# ------------------------------------------------------------
# Your site, if you run one; used in links the bot sends (default https://bloo-bot.xyz)
SITE_URL=
# Fluxer API base URL override (default https://api.fluxer.app)
FLUXER_API=

# FluxerList (fluxerlist.com): posts the live server count so the listing stays
# accurate, and powers b!vote and voter perks. The bot ID comes from
# FLUXER_CLIENT_ID above.
# fl_... from your bot's FluxerList developer settings
FLUXERLIST_API_KEY=

# Voter extras, all optional. A Fluxer webhook for "thanks for voting" posts:
VOTE_THANKS_WEBHOOK_URL=
# Give voters a role in your support server (Bloo's role must sit above it):
VOTE_SUPPORT_GUILD_ID=
VOTE_SUPPORTER_ROLE_ID=

# Community, all optional. b!suggest posts ideas to this channel (usually in
# your support server) with 👍/👎 for voting; without it they're saved but
# not posted anywhere.
SUGGESTIONS_CHANNEL_ID=
# A Fluxer webhook that gets a copy of each private b!feedback note
FEEDBACK_WEBHOOK_URL=
# Beta testers: anyone with this role in this server can use commands marked
# beta before release. The server defaults to VOTE_SUPPORT_GUILD_ID.
BETA_GUILD_ID=
BETA_ROLE_ID=

# twitter:<handle> and x:<handle> feeds (b!webhook add). https://twitterapi.io
TWITTERAPI_KEY=

# Link auditor (b!linkauditor). Optional: archiving works without these, but
# web.archive.org rate-limits anonymous saves hard. Free keys at
# https://archive.org/account/s3.php
ARCHIVE_ORG_ACCESS_KEY=
ARCHIVE_ORG_SECRET_KEY=


# ------------------------------------------------------------
# Bot invite (b!botinvite)
# ------------------------------------------------------------
# Permissions pre-ticked in the invite link (8 = Administrator)
INVITE_PERMISSIONS=8
# Optional, locks the invite link to one server
INVITE_GUILD_ID=

# ------------------------------------------------------------
# Bug reports (b!bugreport)
# ------------------------------------------------------------
# Fluxer webhook the reports go to
REPORT_WEBHOOK=
# Support server invite shown to reporters
REPORT_CONTACT_INVITE=
# Contact email shown to reporters
REPORT_CONTACT_EMAIL=

# ------------------------------------------------------------
# Debugging
# ------------------------------------------------------------
# "true" for verbose logging
DEBUG=

# ------------------------------------------------------------
# Gateway reconnects
# ------------------------------------------------------------
WS_MAX_ATTEMPTS=3
WS_BASE_DELAY_MS=2000
WS_LOGIN_TIMEOUT=10000

# ------------------------------------------------------------
# Watchdog (watchdog.js, optional, run as its own process with pnpm run
# watchdog). It posts alerts only and never restarts the bot; leave
# restarts to your process manager.
# ------------------------------------------------------------
# How often the bot writes its heartbeat
WATCHDOG_HEARTBEAT_INTERVAL_S=15
# Heartbeat older than this: the bot is frozen, restart it
WATCHDOG_HEARTBEAT_TIMEOUT_S=90
# How long a newly started bot gets to write its first heartbeat
WATCHDOG_BOOT_TIMEOUT_S=180
# How often the watchdog checks
WATCHDOG_CHECK_INTERVAL_S=15
# Nothing from the gateway for this long (not even a keep-alive, ~every 40s): the socket is dead, restart
WATCHDOG_WS_SILENCE_TIMEOUT_S=150
# Silence check waits this long after the bot comes up
WATCHDOG_WS_SILENCE_GRACE_S=60
# How often the Fluxer API is checked (alerts only, never restarts)
WATCHDOG_GATEWAY_INTERVAL_S=180
# Failed API checks in a row before alerting
WATCHDOG_GATEWAY_FAIL_THRESHOLD=3
# If the bot announced its own start or shutdown this recently, skip the duplicate public alert
WATCHDOG_GRACEFUL_WINDOW_S=180
# This many watchdog restarts within the window below pauses auto-restart
WATCHDOG_RESTART_LOOP_THRESHOLD=5
WATCHDOG_RESTART_LOOP_WINDOW_S=300
# How long auto-restart stays paused after a restart loop
WATCHDOG_RESTART_BACKOFF_S=120
# Gap between repeat alerts during a long incident (first and recovery alerts always send)
WATCHDOG_ALERT_COOLDOWN_S=3600
# Private, technical alerts
WATCHDOG_WEBHOOK_URL=
# Public status alerts
WATCHDOG_WEBHOOK_PUBLIC_URL=
# Optional webhook name (default "Bloo Watchdog")
WATCHDOG_WEBHOOK_NAME=
# Optional webhook avatar
WATCHDOG_AVATAR_URL=
