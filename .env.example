# ============================================================
# Bloo environment settings
# Build: release-production (no economy, no dashboard)
#
# Copy this file to .env and fill it in before starting. Never commit .env.
# The bot (index.js) and the optional alert watchdog (watchdog.js) both read
# the same .env from this folder. Only FLUXER_BOT_TOKEN and BOT_OWNERS are
# needed to start; everything else is optional.
# ============================================================

# ------------------------------------------------------------
# Core
# ------------------------------------------------------------
FLUXER_BOT_TOKEN=
BOT_OWNERS=                    # Comma-separated user IDs with full bot-owner access
PREFIX=b!                      # Default command prefix for new servers
DB_PATH=data/bot.db            # SQLite database, relative to this folder
FLUXER_CLIENT_ID=              # Your bot application's ID, from your Fluxer developer settings
BLOO_PFP_URL=                  # Bot avatar used on webhook posts


# ------------------------------------------------------------
# Webhooks (all optional, each a Fluxer webhook URL:
# https://api.fluxer.app/webhooks/{id}/{token})
# ------------------------------------------------------------
ERROR_WEBHOOK_URL=             # Error reports from the bot, labelled by area
STARTUP_WEBHOOK_URL=           # Bot start, restart and shutdown notices
FLUXER_STATUS_WEBHOOK_URL=     # Fluxer platform status alerts
CHANGELOG_WEBHOOK_URL=         # Where b!changelog publish posts new releases

# ------------------------------------------------------------
# Features
# ------------------------------------------------------------
SITE_URL=                      # Your site, if you run one; used in links the bot sends (default https://bloo-bot.xyz)
FLUXER_API=                    # Fluxer API base URL override (default https://api.fluxer.app)

# FluxerList (fluxerlist.com): posts the live server count so the listing stays
# accurate. The bot ID comes from FLUXER_CLIENT_ID above.
FLUXERLIST_API_KEY=            # fl_... from your bot's FluxerList developer settings

# twitter:<handle> and x:<handle> feeds (b!webhook add). https://twitterapi.io
TWITTERAPI_KEY=

# Link auditor (b!linkauditor). Optional: archiving works without these, but
# web.archive.org rate-limits anonymous saves hard. Free keys at
# https://archive.org/account/s3.php
ARCHIVE_ORG_ACCESS_KEY=
ARCHIVE_ORG_SECRET_KEY=

# Echo announcement relay (b!echo): most posts one channel may relay per
# minute. A normal announcements channel never gets near it; it only stops a
# spammed channel flooding every subscriber.
ECHO_MAX_PER_MINUTE=10


# ------------------------------------------------------------
# Bot invite (b!botinvite)
# ------------------------------------------------------------
INVITE_PERMISSIONS=8           # Permissions pre-ticked in the invite link (8 = Administrator)
INVITE_GUILD_ID=               # Optional, locks the invite link to one server

# ------------------------------------------------------------
# Bug reports (b!bugreport)
# ------------------------------------------------------------
REPORT_WEBHOOK=                # Fluxer webhook the reports go to
REPORT_CONTACT_INVITE=         # Support server invite shown to reporters
REPORT_CONTACT_EMAIL=          # Contact email shown to reporters

# ------------------------------------------------------------
# Debugging
# ------------------------------------------------------------
DEBUG=                         # "true" for verbose logging

# ------------------------------------------------------------
# Gateway reconnects
# ------------------------------------------------------------
WS_MAX_ATTEMPTS=3
WS_BASE_DELAY_MS=2000
WS_LOGIN_TIMEOUT=10000

# ------------------------------------------------------------
# Watchdog (watchdog.js, optional, run as its own process with pnpm run
# watchdog). It posts alerts only and never restarts the bot; leave
# restarts to your process manager.
# ------------------------------------------------------------
WATCHDOG_HEARTBEAT_INTERVAL_S=15    # How often the bot writes its heartbeat
WATCHDOG_HEARTBEAT_TIMEOUT_S=90     # Heartbeat older than this: the bot is frozen, restart it
WATCHDOG_BOOT_TIMEOUT_S=180         # How long a newly started bot gets to write its first heartbeat
WATCHDOG_CHECK_INTERVAL_S=15        # How often the watchdog checks
WATCHDOG_WS_SILENCE_TIMEOUT_S=150   # Nothing from the gateway for this long (not even a keep-alive, ~every 40s): the socket is dead, restart
WATCHDOG_WS_SILENCE_GRACE_S=60      # Silence check waits this long after the bot comes up
WATCHDOG_GATEWAY_INTERVAL_S=180     # How often the Fluxer API is checked (alerts only, never restarts)
WATCHDOG_GATEWAY_FAIL_THRESHOLD=3   # Failed API checks in a row before alerting
WATCHDOG_GRACEFUL_WINDOW_S=180      # If the bot announced its own start or shutdown this recently, skip the duplicate public alert
WATCHDOG_RESTART_LOOP_THRESHOLD=5   # This many watchdog restarts within the window below pauses auto-restart
WATCHDOG_RESTART_LOOP_WINDOW_S=300
WATCHDOG_RESTART_BACKOFF_S=120      # How long auto-restart stays paused after a restart loop
WATCHDOG_ALERT_COOLDOWN_S=3600      # Gap between repeat alerts during a long incident (first and recovery alerts always send)
WATCHDOG_WEBHOOK_URL=               # Private, technical alerts
WATCHDOG_WEBHOOK_PUBLIC_URL=        # Public status alerts
WATCHDOG_WEBHOOK_NAME=              # Optional webhook name (default "Bloo Watchdog")
WATCHDOG_AVATAR_URL=                # Optional webhook avatar
